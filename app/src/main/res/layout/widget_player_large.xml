<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_placeholder_art"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_nothing_playing"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_empty_artist"
            android:textColor="#D1D4E0"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/widget_empty_album"
            android:textColor="#8E92A4"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0:00 / 0:00"
            android:textColor="#6C7084"
            android:textSize="11sp"
            android:maxLines="1" />

        <LinearLayout
            android:id="@+id/widget_transport_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_shuffle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_btn_bg"
                android:padding="6dp"
                android:src="@drawable/ic_widget_shuffle"
                android:contentDescription="@string/app_name" />

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_btn_bg"
                android:padding="7dp"
                android:src="@drawable/ic_widget_prev"
                android:contentDescription="@string/app_name" />

            <ImageView
                android:id="@+id/widget_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_btn_bg"
                android:padding="8dp"
                android:src="@drawable/ic_widget_play"
                android:contentDescription="@string/app_name" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_btn_bg"
                android:padding="7dp"
                android:src="@drawable/ic_widget_next"
                android:contentDescription="@string/app_name" />

            <ImageView
                android:id="@+id/widget_repeat"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_btn_bg"
                android:padding="6dp"
                android:src="@drawable/ic_widget_repeat"
                android:contentDescription="@string/app_name" />

            <ImageView
                android:id="@+id/widget_stop"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_btn_bg"
                android:padding="7dp"
                android:src="@drawable/ic_widget_stop"
                android:contentDescription="@string/app_name" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
